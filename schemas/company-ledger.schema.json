{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krystofmincev/value_deep_dives/schemas/company-ledger.schema.json",
  "title": "Company forecast ledger row",
  "type": "object",
  "required": ["id", "published_at", "source_cutoff_at", "ticker", "identity_path", "identity_hash", "security_id", "listing_id", "thesis_path", "commit_url", "currency", "reference_price", "reference_price_at", "price_source", "target_bear", "target_base", "target_bull", "target_horizon", "evaluation_rule", "benchmark", "position_disclosure", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[0-9]{4}-T[0-9]{3,}$" },
    "published_at": { "type": "string", "format": "date-time" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "identity_path": { "type": "string", "minLength": 1 },
    "identity_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "security_id": { "type": "string", "minLength": 1 },
    "listing_id": { "type": "string", "minLength": 1 },
    "thesis_path": { "type": "string", "minLength": 1 },
    "commit_url": { "type": "string", "format": "uri", "pattern": "^https://[^/@?#\\s]+/.+/commit/(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "reference_price": { "type": "number", "exclusiveMinimum": 0 },
    "reference_price_at": { "type": "string", "format": "date-time" },
    "price_source": { "type": "string", "minLength": 1 },
    "target_bear": { "type": "number", "exclusiveMinimum": 0 },
    "target_base": { "type": "number", "exclusiveMinimum": 0 },
    "target_bull": { "type": "number", "exclusiveMinimum": 0 },
    "target_horizon": { "type": "string", "format": "date" },
    "evaluation_rule": { "type": "string", "minLength": 1 },
    "benchmark": { "type": "string", "minLength": 1 },
    "sector_benchmark": { "type": ["string", "null"] },
    "position_disclosure": { "enum": ["long", "short", "no_position", "not_disclosed"] },
    "status": { "enum": ["active", "superseded", "closed", "invalidated"] },
    "outcome_date": { "type": ["string", "null"], "format": "date" }
  },
  "additionalProperties": false
}
