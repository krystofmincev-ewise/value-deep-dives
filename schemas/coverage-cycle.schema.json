{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/value-deep-dives/coverage-cycle.schema.json",
  "title": "Company Coverage Cycle",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "type",
    "coverage_cycle_id",
    "company",
    "ticker",
    "cycle_number",
    "cycle_kind",
    "iso_week",
    "status",
    "research_status",
    "started_at",
    "as_of",
    "final_report_path",
    "valuation_path",
    "decision_path",
    "valuation_contract_path",
    "review_status"
  ],
  "properties": {
    "type": { "const": "company_coverage_cycle" },
    "coverage_cycle_id": { "type": "string", "pattern": "^[A-Z0-9.-]+-[0-9]{4}-W[0-9]{2}-[0-9]{2}$" },
    "company": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "cycle_number": { "type": "integer", "minimum": 1 },
    "cycle_kind": { "type": "string", "enum": ["initial", "revaluation", "restart"] },
    "iso_week": { "type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$" },
    "status": { "type": "string", "enum": ["active", "complete", "superseded", "withdrawn"] },
    "research_status": { "type": "string", "enum": ["researching", "draft", "published", "superseded", "withdrawn"] },
    "started_at": { "type": "string", "format": "date" },
    "as_of": { "type": "string", "format": "date" },
    "source_cutoff_at": { "type": ["string", "null"], "format": "date-time" },
    "prior_cycle_path": { "type": ["string", "null"] },
    "final_report_path": { "type": "string", "minLength": 1 },
    "valuation_path": { "type": "string", "minLength": 1 },
    "decision_path": { "type": "string", "minLength": 1 },
    "valuation_contract_path": { "type": "string", "minLength": 1 },
    "forecast_path": { "type": ["string", "null"] },
    "review_status": {
      "type": "string",
      "enum": ["not_requested", "pending", "passed", "failed", "stale"]
    },
    "review_path": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "finalized_at": { "type": ["string", "null"], "format": "date-time" },
    "final_report_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "valuation_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "decision_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "review_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "valuation_contract_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "model_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
    "verifier_hash": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          { "properties": { "status": { "const": "complete" } }, "required": ["status"] },
          { "properties": { "research_status": { "const": "published" } }, "required": ["research_status"] }
        ]
      },
      "then": {
        "properties": {
          "review_status": { "const": "passed" },
          "finalized_at": { "type": "string", "format": "date-time" },
          "reviewed_at": { "type": "string", "format": "date-time" },
          "final_report_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "valuation_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "decision_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "valuation_contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "review_path": { "type": "string", "minLength": 1 },
          "review_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "model_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "verifier_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "required": [
          "finalized_at",
          "final_report_hash",
          "valuation_hash",
          "decision_hash",
          "valuation_contract_hash",
          "review_path",
          "review_hash",
          "review_status",
          "reviewed_at",
          "model_hash",
          "verifier_hash"
        ]
      }
    },
    {
      "if": {
        "properties": { "review_status": { "const": "passed" } },
        "required": ["review_status"]
      },
      "then": {
        "properties": {
          "reviewed_at": { "type": "string", "format": "date-time" },
          "review_path": { "type": "string", "minLength": 1 },
          "review_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "final_report_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "valuation_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "decision_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "valuation_contract_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "model_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "verifier_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
        },
        "required": [
          "reviewed_at",
          "review_path",
          "review_hash",
          "final_report_hash",
          "valuation_hash",
          "decision_hash",
          "valuation_contract_hash",
          "model_hash",
          "verifier_hash"
        ]
      }
    }
  ]
}
