{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krystofmincev/value_deep_dives/schemas/event-candidate-ledger.schema.json",
  "title": "Event candidate ledger row",
  "type": "object",
  "required": [
    "candidate_id", "cohort_id", "identified_at", "source_cutoff_at", "ticker", "identity_path",
    "security_id", "listing_id", "event_type", "event_window_start", "event_window_end",
    "eligibility_rule_id", "decision", "decision_at", "reason"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^\\d{4}-C\\d{3,}$" },
    "cohort_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "identified_at": { "type": "string", "format": "date-time" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "identity_path": { "type": "string", "minLength": 1 },
    "security_id": { "type": "string", "minLength": 1 },
    "listing_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "enum": ["earnings", "clinical_trial", "regulatory", "product", "customer_contract", "legal", "policy", "capital_allocation", "financing", "m_and_a", "commodity", "macro", "other"]
    },
    "event_window_start": { "type": "string", "format": "date-time" },
    "event_window_end": { "type": "string", "format": "date-time" },
    "eligibility_rule_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["registered", "abstained", "ineligible", "deferred"] },
    "decision_at": { "type": "string", "format": "date-time" },
    "reason": { "type": "string", "minLength": 1 },
    "forecast_id": { "type": ["string", "null"], "pattern": "^\\d{4}-E\\d{3,}$" }
  },
  "additionalProperties": false
}
