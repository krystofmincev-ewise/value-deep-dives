{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krystofmincev/value_deep_dives/schemas/event-forecast.schema.json",
  "title": "Event forecast front matter",
  "type": "object",
  "required": [
    "type",
    "forecast_id",
    "company",
    "ticker",
    "identity_path",
    "identity_hash",
    "security_id",
    "listing_id",
    "status",
    "as_of",
    "source_cutoff_at",
    "event_baseline_id",
    "event_baseline_source_path",
    "event_baseline_probability_pct",
    "event_baseline_sample_size",
    "target_baseline_id",
    "target_baseline_source_path",
    "target_baseline_probability_pct",
    "method_version",
    "event_type",
    "schedule_source",
    "schedule_known_at",
    "event_window_start",
    "event_window_end",
    "no_release_check_url",
    "market_session",
    "event_outcome_rule",
    "deadline_miss_resolution",
    "evaluation_spec_id",
    "security_return_rule",
    "return_basis",
    "entry_observation_rule",
    "return_metric",
    "target_direction",
    "currency",
    "benchmark_price_adjustment_rule",
    "position_disclosure"
  ],
  "properties": {
    "type": { "const": "event_forecast" },
    "forecast_id": { "type": "string", "pattern": "^\\d{4}-E\\d{3,}$" },
    "candidate_id": { "type": ["string", "null"], "pattern": "^\\d{4}-C\\d{3,}$" },
    "candidate_ledger_commit_url": { "type": ["string", "null"], "pattern": "^https://[^/@?#\\s]+/.+/commit/(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$" },
    "company": { "type": "string", "minLength": 1 },
    "ticker": { "type": "string", "pattern": "^[A-Z0-9.-]+$" },
    "identity_path": { "type": "string", "minLength": 1 },
    "identity_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "security_id": { "type": "string", "minLength": 1 },
    "listing_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["draft", "published", "superseded", "withdrawn"] },
    "as_of": { "type": "string", "format": "date" },
    "published_at": { "type": ["string", "null"], "format": "date-time" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "event_baseline_id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
    "event_baseline_source_path": { "type": "string", "minLength": 1 },
    "event_baseline_probability_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "event_baseline_sample_size": { "type": ["integer", "null"], "minimum": 1 },
    "target_baseline_id": { "type": "string", "pattern": "^S-[0-9]{3,}$" },
    "target_baseline_source_path": { "type": "string", "minLength": 1 },
    "target_baseline_probability_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "method_version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "fact_snapshot_hash": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9:_-]+$" },
    "fact_snapshot_path": { "type": ["string", "null"] },
    "event_type": {
      "enum": [
        "earnings",
        "clinical_trial",
        "regulatory",
        "product",
        "customer_contract",
        "legal",
        "policy",
        "capital_allocation",
        "financing",
        "m_and_a",
        "commodity",
        "macro",
        "other"
      ]
    },
    "event_window_start": { "type": "string", "format": "date-time" },
    "event_window_end": { "type": "string", "format": "date-time" },
    "no_release_check_url": { "type": "string", "format": "uri", "pattern": "^https?://[^/@?#\\s]+(?:[/?#][^\\s]*)?$" },
    "schedule_source": { "type": "string", "format": "uri", "pattern": "^https?://[^/@?#\\s]+(?:[/?#][^\\s]*)?$" },
    "schedule_known_at": { "type": "string", "format": "date-time" },
    "market_session": { "enum": ["pre_market", "regular", "after_hours", "unknown"] },
    "event_outcome_rule": { "type": "string", "minLength": 1 },
    "deadline_miss_resolution": { "enum": ["event_zero", "unresolvable"] },
    "event_probability_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "evaluation_spec_id": { "type": "string", "pattern": "^event-v[1-9][0-9]*$" },
    "security_return_rule": { "type": "string", "minLength": 1 },
    "return_basis": { "enum": ["decision_holding_period", "event_reaction"] },
    "entry_observation_rule": { "enum": ["reference_price", "last_close_before_release"] },
    "return_metric": { "enum": ["security_total_return", "benchmark_relative_return"] },
    "target_direction": { "enum": ["up", "down", "absolute"] },
    "target_return_threshold_pct": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "target_return_window_sessions": { "type": ["integer", "null"], "minimum": 1 },
    "target_probability_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "reference_price": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "reference_price_at": { "type": ["string", "null"], "format": "date-time" },
    "reference_price_source": { "type": ["string", "null"] },
    "price_adjustment_rule": {
      "enum": ["unadjusted", "split_adjusted", "split_adjusted_with_dividends"]
    },
    "benchmark": { "type": ["string", "null"] },
    "benchmark_price_source": { "type": ["string", "null"] },
    "benchmark_price_adjustment_rule": { "enum": ["unadjusted", "split_adjusted", "split_adjusted_with_dividends"] },
    "position_disclosure": { "enum": ["long", "short", "no_position", "not_disclosed"] },
    "review_by": { "type": ["string", "null"], "format": "date" },
    "supersedes": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "return_basis": { "const": "decision_holding_period" } },
        "required": ["return_basis"]
      },
      "then": { "properties": { "entry_observation_rule": { "const": "reference_price" } } }
    },
    {
      "if": {
        "properties": { "return_basis": { "const": "event_reaction" } },
        "required": ["return_basis"]
      },
      "then": { "properties": { "entry_observation_rule": { "const": "last_close_before_release" } } }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["published", "superseded", "withdrawn"] } },
        "required": ["status"]
      },
      "then": {
        "required": [
          "published_at",
          "candidate_id",
          "candidate_ledger_commit_url",
          "event_baseline_probability_pct",
          "event_baseline_sample_size",
          "target_baseline_probability_pct",
          "fact_snapshot_path",
          "fact_snapshot_hash",
          "event_probability_pct",
          "target_return_threshold_pct",
          "target_return_window_sessions",
          "target_probability_pct",
          "reference_price",
          "reference_price_at",
          "reference_price_source",
          "price_adjustment_rule",
          "benchmark",
          "benchmark_price_source",
          "benchmark_price_adjustment_rule"
        ],
        "properties": {
          "published_at": { "type": "string", "format": "date-time" },
          "event_baseline_probability_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "event_baseline_sample_size": { "type": "integer", "minimum": 1 },
          "target_baseline_probability_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "fact_snapshot_path": { "type": "string", "minLength": 1 },
          "fact_snapshot_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "event_probability_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "target_return_threshold_pct": { "type": "number", "exclusiveMinimum": 0 },
          "target_return_window_sessions": { "type": "integer", "minimum": 1 },
          "target_probability_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "reference_price": { "type": "number", "exclusiveMinimum": 0 },
          "reference_price_at": { "type": "string", "format": "date-time" },
          "reference_price_source": { "type": "string", "minLength": 1 },
          "benchmark": { "type": "string", "minLength": 1 },
          "benchmark_price_source": { "type": "string", "minLength": 1 }
        }
      }
    }
  ],
  "additionalProperties": false
}
