{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/krystofmincev/value_deep_dives/schemas/fact-snapshot.schema.json",
  "title": "Frozen point-in-time fact snapshot",
  "type": "object",
  "required": ["type", "snapshot_id", "created_at", "source_cutoff_at", "records"],
  "properties": {
    "type": { "const": "fact_snapshot" },
    "snapshot_id": { "type": "string", "pattern": "^FS-[0-9]{3,}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fact_path", "source_path"],
        "properties": {
          "fact_path": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
