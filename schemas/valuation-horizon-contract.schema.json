{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/value-deep-dives/valuation-horizon-contract.schema.json",
  "title": "Valuation Horizon Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schema_version",
    "coverage_cycle_id",
    "valuation_quantity",
    "currency",
    "as_of",
    "source_cutoff_at",
    "reference_price",
    "reference_price_at",
    "reference_price_source",
    "primary_horizon",
    "display_semantics",
    "model",
    "horizons",
    "horizon_relationship"
  ],
  "properties": {
    "type": { "const": "valuation_horizon_contract" },
    "schema_version": { "const": 1 },
    "coverage_cycle_id": {
      "type": "string",
      "pattern": "^[A-Z0-9.-]+-[0-9]{4}-W[0-9]{2}-[0-9]{2}$"
    },
    "valuation_quantity": {
      "type": "string",
      "enum": [
        "fair_value_per_share",
        "intrinsic_value_per_share",
        "target_date_market_price"
      ]
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "as_of": { "type": "string", "format": "date" },
    "source_cutoff_at": { "type": "string", "format": "date-time" },
    "reference_price": { "type": "number", "exclusiveMinimum": 0 },
    "reference_price_at": { "type": "string", "format": "date-time" },
    "reference_price_source": { "type": "string", "minLength": 1 },
    "primary_horizon": { "type": "string", "format": "date" },
    "display_semantics": { "const": "distribution_percentiles" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "method",
        "calibration_status",
        "seed",
        "sample_count",
        "code_path",
        "verifier_path"
      ],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "calibration_status": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "code_path": { "type": "string", "minLength": 1 },
        "verifier_path": { "type": "string", "minLength": 1 }
      }
    },
    "horizons": {
      "type": "array",
      "description": "Schema version 1 supports one or two horizons ordered earliest to latest.",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "date",
          "months_from_reference",
          "output_kind",
          "p10",
          "p50",
          "p90",
          "mean",
          "probability_below_reference",
          "probability_loss_30_pct",
          "probability_loss_50_pct",
          "bottom_decile_mean"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" },
          "date": { "type": "string", "format": "date" },
          "months_from_reference": { "type": "number", "exclusiveMinimum": 0 },
          "output_kind": { "const": "distribution" },
          "p10": { "type": "number", "minimum": 0 },
          "p50": { "type": "number", "minimum": 0 },
          "p90": { "type": "number", "minimum": 0 },
          "mean": { "type": "number", "minimum": 0 },
          "probability_below_reference": { "type": "number", "minimum": 0, "maximum": 1 },
          "probability_loss_30_pct": { "type": "number", "minimum": 0, "maximum": 1 },
          "probability_loss_50_pct": { "type": "number", "minimum": 0, "maximum": 1 },
          "bottom_decile_mean": { "type": "number", "minimum": 0 }
        }
      }
    },
    "horizon_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "linkage_method",
        "value_correlation_method",
        "value_correlation",
        "probability_later_above_earlier",
        "transition_bands",
        "sensitivity_note"
      ],
      "properties": {
        "kind": { "type": "string", "enum": ["single", "joint", "independent"] },
        "linkage_method": { "type": ["string", "null"] },
        "value_correlation_method": {
          "type": ["string", "null"],
          "enum": ["pearson", "spearman", "kendall", null]
        },
        "value_correlation": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "probability_later_above_earlier": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "transition_bands": {
          "type": "array",
          "description": "For a joint pair, later-horizon outcomes conditional on ordered earlier-horizon bands.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "earlier_band_upper_probability",
              "earlier_band_sample_probability",
              "later_mean",
              "later_median",
              "later_probability_below_reference"
            ],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "earlier_band_upper_probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "earlier_band_sample_probability": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "later_mean": { "type": "number", "minimum": 0 },
              "later_median": { "type": "number", "minimum": 0 },
              "later_probability_below_reference": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "sensitivity_note": { "type": ["string", "null"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "horizon_relationship": {
            "properties": { "kind": { "const": "single" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "horizons": { "maxItems": 1 },
          "horizon_relationship": {
            "properties": {
              "linkage_method": { "type": "null" },
              "value_correlation_method": { "type": "null" },
              "value_correlation": { "type": "null" },
              "probability_later_above_earlier": { "type": "null" },
              "transition_bands": { "maxItems": 0 },
              "sensitivity_note": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "horizon_relationship": {
            "properties": { "kind": { "const": "joint" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "horizons": { "minItems": 2 },
          "horizon_relationship": {
            "properties": {
              "linkage_method": { "type": "string", "minLength": 1 },
              "value_correlation_method": {
                "type": "string",
                "enum": ["pearson", "spearman", "kendall"]
              },
              "value_correlation": { "type": "number" },
              "probability_later_above_earlier": { "type": "number" },
              "transition_bands": { "minItems": 2 },
              "sensitivity_note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "horizon_relationship": {
            "properties": { "kind": { "const": "independent" } },
            "required": ["kind"]
          }
        }
      },
      "then": {
        "properties": {
          "horizons": { "minItems": 2 },
          "horizon_relationship": {
            "properties": {
              "linkage_method": { "type": "null" },
              "value_correlation_method": { "type": "null" },
              "value_correlation": { "type": "null" },
              "probability_later_above_earlier": { "type": "null" },
              "transition_bands": { "maxItems": 0 },
              "sensitivity_note": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  ]
}
