{
  "type": "review_artifact_manifest",
  "schema_version": 1,
  "coverage_cycle_id": "{TICKER}-{YYYY-Www}-{NN}",
  "source_cutoff_at": "{YYYY-MM-DDTHH:mm:ssZ}",
  "artifacts": [
    {
      "path": "model-inputs.json",
